PORT=3000
DATABASE_URL=postgresql://german_vocab:change-me@127.0.0.1:5432/german_vocab
API_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-domain.example/vocab

TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id
REVIEW_ACTION_SECRET=replace-with-another-long-random-secret
REVIEW_TELEGRAM_BOT_TOKEN=replace-with-your-review-bot-token
REVIEW_TELEGRAM_CHAT_ID=replace-with-your-review-chat-id

# Docker Compose: password for the bundled PostgreSQL (DATABASE_URL is then set by compose.yaml)
POSTGRES_PASSWORD=replace-with-a-long-random-password

DAILY_REVIEW_TIMEZONE=Europe/Berlin
# Old 9:00 review push, off unless enabled
DAILY_REVIEW_ENABLED=false
DAILY_REVIEW_CRON=0 9 * * *
# One reminder after two days without activity (19:00)
NUDGE_ENABLED=true

# Daily lesson and writing correction (comma-separated, tried in order)
LESSON_MODELS=gemini-flash-lite-latest,gemini-flash-latest
LEARNING_MODELS=gemini-flash-latest,gemini-flash-lite-latest
GERMAN_LEVEL=B2

GEMINI_API_KEY=replace-with-your-google-ai-api-key
AI_EXPLAIN_MODEL=gemma-4-26b-a4b-it
AI_EXPLAIN_FALLBACK_MODEL=gemini-3.1-flash-lite
